{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@auraflux/design-system/*": ["packages/design-system/src/*"],
      "@auraflux/shared-core/*": ["packages/shared-core/src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "**/*.spec.ts"
  ],
  "exclude": ["node_modules"]
}
